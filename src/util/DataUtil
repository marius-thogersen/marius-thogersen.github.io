
class TimeFormat {
    constructor(hours, min,sec,ms){
        this.hours = hours;
        this.min = min;
        this.sec = sec;
        this.ms = ms;
    }

    toString(){
        let result = "";
        result
        result += this.hours > 0 ? this.hours.toString() + ":" : "";
        result += this.min.toString().padStart(2,'0');
        result += ":";
        result += this.sec.toString().padStart(2,'0')
        return result;
       }
}


class Seconds {
    constructor(sec){
        this.sec = sec;
    }

    format() {
        const hours = Math.floor(this.sec / 60 / 60)
        const minutes = Math.floor((this.sec / 60) % 60 );
        const seconds = Math.floor(this.sec % 60);
        const ms = (this.sec % 1).toFixed(3) * 1000;
        return new TimeFormat(hours, minutes, seconds, ms);
    }
}

const formatSeconds = function (seconds) {
    const sec = new Seconds(seconds)
    return sec.format();
}


